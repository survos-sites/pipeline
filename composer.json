{
    "name": "survos/ai-workflow",
    "description": "Demo app for survos/ai-workflow-bundle — runs AI workflow and tasks",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "api-platform/doctrine-orm": "^4.3 || ^5.0",
        "api-platform/symfony": "^4.3 || ^5.0",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "league/commonmark": "^2.7.1",
        "nelmio/cors-bundle": "^2.6",
        "php": "^8.5",
        "phpdocumentor/reflection-docblock": "^5.6|^6.0",
        "phpstan/phpdoc-parser": "^2.3",
        "survos/ai-workflow-bundle": "^2.44",
        "survos/claims-bundle": "^2.0",
        "survos/data-contracts": "^2.0",
        "survos/field-bundle": "*",
        "survos/grid-bundle": "^2.34.39",
        "survos/imgproxy-bundle": "^2.2",
        "survos/import-bundle": "^2.2",
        "survos/js-twig-bundle": "^2.2",
        "survos/media-bundle": "^2.42.13",
        "survos/menu-bundle": "^2.42.7",
        "survos/tabler-bundle": "^2.42.9",
        "survos/workflow-extras-bundle": "^2.42.13",
        "survos/workflow-messenger-bundle": "^2.42.13",
        "symfony/ai-agent": "^1.0.0-beta1",
        "symfony/ai-bundle": "^1.0.0-beta1",
        "symfony/ai-platform": "^1.0.0-beta1",
        "symfony/ai-store": "^1.0.0-beta1",
        "symfony/ai-type-safe-platform": "^1.0.0-beta1",
        "symfony/asset": "8.2.*@dev",
        "symfony/asset-mapper": "8.2.*@dev",
        "symfony/console": "8.2.*@dev",
        "symfony/doctrine-messenger": "8.2.*@dev",
        "symfony/dotenv": "8.2.*@dev",
        "symfony/expression-language": "8.2.*@dev",
        "symfony/flex": "^2",
        "symfony/form": "8.2.*@dev",
        "symfony/framework-bundle": "8.2.*@dev",
        "symfony/http-client": "8.2.*@dev",
        "symfony/intl": "8.2.*@dev",
        "symfony/mailer": "8.2.*@dev",
        "symfony/mime": "8.2.*@dev",
        "symfony/monolog-bundle": "^4.0",
        "symfony/notifier": "8.2.*@dev",
        "symfony/process": "8.2.*@dev",
        "symfony/property-access": "8.2.*@dev",
        "symfony/property-info": "8.2.*@dev",
        "symfony/runtime": "8.2.*@dev",
        "symfony/security-bundle": "8.2.*@dev",
        "symfony/serializer": "8.2.*@dev",
        "symfony/stimulus-bundle": "^3.0",
        "symfony/string": "8.2.*@dev",
        "symfony/translation": "8.2.*@dev",
        "symfony/tui": "8.2.*@dev",
        "symfony/twig-bundle": "8.2.*@dev",
        "symfony/ux-turbo": "^3.0",
        "symfony/ux-twig-component": "^3.0",
        "symfony/validator": "8.2.*@dev",
        "symfony/web-link": "8.2.*@dev",
        "symfony/workflow": "8.2.*@dev",
        "symfony/yaml": "8.2.*@dev",
        "tempest/highlight": "^2.26",
        "twig/extra-bundle": "^3.0",
        "twig/html-extra": "^3.24",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "survos/deployment-bundle": "*",
        "symfony/browser-kit": "8.2.*@dev",
        "symfony/css-selector": "8.2.*@dev",
        "symfony/debug-bundle": "8.2.*@dev",
        "symfony/maker-bundle": "^1.0",
        "symfony/stopwatch": "8.2.*@dev",
        "symfony/web-profiler-bundle": "8.2.*@dev"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "importmap:install": "symfony-cmd",
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "php -d memory_limit=512M bin/console cache:clear",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "php -d memory_limit=512M bin/console cache:clear",
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.2.*"
        }
    }
}
