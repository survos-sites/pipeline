{
    "controllers": {
        "@survos/iiif-bundle": {
            "iiif-viewer": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            },
            "iiif-diva": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            },
            "iiif-pdf": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            }
        },
        "@survos/imgproxy-bundle": {
            "imgproxy": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            }
        },
        "@survos/js-twig-bundle": {
            "dexie": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": []
            },
            "js_twig": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            }
        },
        "@survos/simple-datatables-bundle": {
            "table": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": {
                    "@survos/simple-datatables/style.css": true
                }
            }
        },
        "@survos/state-bundle": {
            "workflow": {
                "enabled": true,
                "fetch": "eager"
            }
        },
        "@survos/tabler-bundle": {
            "accordion": {
                "enabled": true,
                "fetch": "lazy"
            },
            "search": {
                "enabled": true,
                "fetch": "lazy"
            },
            "clipboard": {
                "enabled": true,
                "fetch": "lazy"
            },
            "closeable": {
                "enabled": true,
                "fetch": "lazy"
            },
            "tooltip": {
                "enabled": true,
                "fetch": "lazy"
            }
        },
        "@symfony/ux-turbo": {
            "turbo-core": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "@symfony/ux-turbo/dist/mercure_stream_source_element.js": true
                }
            },
            "mercure-turbo-stream": {
                "enabled": false,
                "fetch": "eager"
            }
        }
    },
    "entrypoints": []
}
