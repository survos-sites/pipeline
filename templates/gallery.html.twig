{% extends 'base.html.twig' %}
{% block page_title %}Archive Alchemy{% endblock %}
{% block page_subtitle %}AI possibilities for your collection · Museado{% endblock %}
{% block body %}
<section class="case-intro mb-4">
    <div class="case-eyebrow">Cultural heritage · AI case studies</div>
    <h2>From archival objects to usable data.</h2>
    <p>See how photographs, letters and newspaper stories can become easier to search, understand and share. These three examples use our collections and workflows, with original sources and honest results.</p>
    <span class="text-secondary">{{ images|length }} case studies to explore</span>
</section>
<div class="row g-4">
{% for image in images %}
    <article class="col-sm-6 col-xl-4">
        <div class="card case-card h-100">
            <a href="{{ path('app_gallery_show', image.rp) }}" tabindex="-1" aria-hidden="true"><img class="case-preview" src="{{ image.displayUrl }}" alt="" loading="lazy"></a>
            <div class="card-body">
                <div class="case-eyebrow">{{ image.collection ?? 'Source collection not recorded' }}</div>
                <h3 class="mt-2"><a href="{{ path('app_gallery_show', image.rp) }}">{{ image.title }}</a></h3>
                <p><strong>Our goal</strong><br>{{ image.legacy.goal|default('Turn this source into searchable text and descriptive metadata, with evidence for each result.') }}</p>
                <a class="case-link" href="{{ path('app_gallery_show', image.rp) }}">Explore the case study →</a>
            </div>
        </div>
    </article>
{% else %}<p>No sources imported yet.</p>{% endfor %}
</div>
{% endblock %}
