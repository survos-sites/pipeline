{% extends 'base.html.twig' %}

{% block page_title %}Gallery{% endblock %}
{% block page_subtitle %}Plain image workflow subjects imported from the gallery manifest.{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ images|length  }} Images</h3>
            <div class="card-actions">
                <span class="badge bg-blue-lt">{{ images|length }} records</span>
            </div>
        </div>
        <div class="card-body">
            <twig:simple_datatables
                :data="images"
                :columns="[
                    {name: 'title', title: 'Title'},
                    {name: 'collection', title: 'Collection'},
                    {name: 'marking', title: 'Place'},
                    {name: 'pendingSteps', title: 'Pending Steps'}
                ]"
                :perPage="25"
            />
        </div>
    </div>

    <div class="row row-cards mt-3">
        {% for image in images %}
            <div class="col-sm-6 col-lg-4">
                <div class="card">
                    <a href="{{ path('app_gallery_show', image.rp) }}" class="d-block">
                        <div class="img-responsive img-responsive-4x3 card-img-top" style="background-image: url('{{ image.displayUrl }}')"></div>
                    </a>
                    <div class="card-body">
                        <h3 class="card-title">
                            <a href="{{ path('app_gallery_show', image.rp) }}" class="text-reset">{{ image.title }}</a>
                        </h3>
                        <div class="text-secondary">{{ image.collection ?? 'Uncollected' }}</div>
                        <div class="mt-2">
                            <span class="badge bg-blue-lt">{{ image.marking }}</span>
                            {% if image.allPendingSteps|length > 0 %}
                                <span class="badge bg-yellow-lt">{{ image.allPendingSteps|length }} pending</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
